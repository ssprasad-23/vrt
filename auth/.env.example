DB_HOST=localhost
DB_DATABASE=postgres
DB_PORT=5432
DB_USER=postgres

PORT=3000

# Generate real values with: openssl rand -hex 64
# Must be kept secret and must NOT match REFRESH_TOKEN_SECRET
ACCESS_TOKEN_SECRET=replace-with-a-random-64-byte-hex-string
# Must be kept secret and must NOT match ACCESS_TOKEN_SECRET
REFRESH_TOKEN_SECRET=replace-with-a-different-random-64-byte-hex-string

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d