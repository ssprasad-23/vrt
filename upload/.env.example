DB_HOST=localhost
DB_DATABASE=postgres
DB_PORT=5432
DB_USER=postgres

# Server port
PORT=3001

# Must match the auth service's ACCESS_TOKEN_SECRET exactly, so tokens it issues verify here
# Generate real values with: openssl rand -hex 64
ACCESS_TOKEN_SECRET=replace-with-a-random-64-byte-hex-string

# MinIO (S3-compatible), local dev
S3_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=test
# UPLOAD_URL_EXPIRY_SECONDS=900